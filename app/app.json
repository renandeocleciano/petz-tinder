{
  "expo": {
    "name": "Petz",
    "slug": "petz",
    "scheme": "petz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF9F4",
    "ios": {
      "bundleIdentifier": "com.petz.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.petz.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFF9F4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "@clerk/expo",
      "expo-secure-store",
      "expo-web-browser",
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#FFF9F4"
        }
      ],
      "@rnmapbox/maps",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Petz usa sua localização aproximada para mostrar pets por perto. Sua localização exata nunca é exibida."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Petz precisa acessar suas fotos para você adicionar fotos do seu pet.",
          "cameraPermission": "O Petz precisa da câmera para você tirar fotos do seu pet."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF654F"
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ad458453-fcb5-40a1-aee5-6f4f732cfa38"
      }
    },
    "owner": "renandeocleciano"
  }
}
