# Clerk (https://dashboard.clerk.com → API keys). Sem esta chave o app usa um login de desenvolvimento.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Mapbox public token (pk.*). Tokens públicos podem ir no cliente; nunca use um token secreto (sk.*) aqui.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=

# URL do backend Petz, com ou sem /v1 (ex.: https://petz-backend-production.up.railway.app).
# Vazio = usa os mocks locais em src/lib/api/mock.
EXPO_PUBLIC_API_URL=

# Mock: "true" inicia sem pets cadastrados para testar o onboarding.
EXPO_PUBLIC_MOCK_NEW_USER=false

# Supabase Realtime (chat ao vivo). Valores PÚBLICOS: URL do projeto e chave publishable
# (sb_publishable_*). Nunca use a secret/service_role aqui. O acesso é limitado pelo RLS
# com o token do Clerk. Vazio = o chat atualiza por polling.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
