NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Supabase → Settings → Database → Connection string (pooler, session mode, port 5432)
DATABASE_URL=

# Supabase → Settings → API. The service role key never leaves the server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Clerk → API keys / Webhooks
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
# Optional: comma-separated `azp` values accepted in session tokens
CLERK_AUTHORIZED_PARTIES=

# Optional: comma-separated origins for browser clients (the mobile app needs none)
CORS_ORIGINS=

SENTRY_DSN=

# Expo push. Optional: only needed with "Enhanced push security" enabled in the Expo project.
EXPO_ACCESS_TOKEN=
